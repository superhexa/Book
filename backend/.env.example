# TurfBook backend — مثال متغيرات البيئة
# انسخ هذا الملف إلى ‎.env‎ وعبّئ القيم الحقيقية. لا تُدخل أسراراً حقيقية هنا أبداً.
# Copy to `.env` and fill in real values. NEVER commit real secrets.

# --- قاعدة البيانات / Database (مطلوبة / required) ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=turfbook

# --- المصادقة / Auth ---
# مفتاح توقيع JWT — استخدم قيمة عشوائية طويلة (32+ حرفاً) في الإنتاج
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ALG=HS256
ACCESS_MINUTES=30
REFRESH_DAYS=30

# --- المدير العام / Super admin bootstrap ---
SUPER_ADMIN_EMAIL=admin@turfbook.com
SUPER_ADMIN_PASSWORD=change-me-in-production

# --- الشبكة / CORS ---
CORS_ORIGINS=*

# --- التخزين / Object storage (S3-compatible: AWS S3 / Cloudflare R2 / MinIO) ---
# اترك S3_BUCKET فارغاً لاستخدام التخزين المحلي تحت backend/uploads
# Leave S3_BUCKET empty to fall back to local filesystem storage.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LOCAL_UPLOADS_DIR=./uploads

# --- الدفع / Payments (webhook secrets تُضبط هنا، لا في الواجهة) ---
PAYMENT_WEBHOOK_SECRET=

# --- الإشعارات الفورية / Web push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@turfbook.com

# --- اللغة / i18n ---
DEFAULT_LOCALE=ar-JO

# --- البيئة / Environment ---
APP_ENV=development

# --- بيانات تجريبية / Demo seed (لا تُفعّل في الإنتاج / never in production) ---
SEED_DEMO=0

# --- الاختبارات / Tests ---
# اتركه فارغاً لتشغيل الاختبارات على قاعدة وهمية داخل الذاكرة.
# عيّنه على رابط MongoDB حقيقي لاختبارات التكامل الحية.
# Leave empty to run tests against the in-memory fake DB.
# Set to a real MongoDB URL for live integration tests.
TEST_MONGO_URL=
